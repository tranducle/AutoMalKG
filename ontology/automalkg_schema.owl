<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/automalkg/schema"
         xmlns="https://example.org/automalkg/schema#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="https://example.org/automalkg/schema"/>

<owl:ObjectProperty rdf:about="#Uses">
  <rdfs:domain rdf:resource="#ThreatActor"/>
  <rdfs:range rdf:resource="#Malware"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#Targets">
  <rdfs:domain rdf:resource="#Entity"/>
  <rdfs:range rdf:resource="#Vulnerability"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#AssociatedWith">
  <rdfs:domain rdf:resource="#Malware"/>
  <rdfs:range rdf:resource="#Campaign"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#HasIndicator">
  <rdfs:domain rdf:resource="#Malware"/>
  <rdfs:range rdf:resource="#Indicator"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Entity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ThreatActor">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Malware">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Vulnerability">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Indicator">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Campaign">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<swrl:Variable rdf:about="urn:swrl#a"/>

<swrl:Variable rdf:about="urn:swrl#m"/>

<swrl:Variable rdf:about="urn:swrl#v"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#ThreatActor"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#Uses"/>
              <swrl:argument1 rdf:resource="urn:swrl#a"/>
              <swrl:argument2 rdf:resource="urn:swrl#m"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:ClassAtom>
                  <swrl:classPredicate rdf:resource="#Malware"/>
                  <swrl:argument1 rdf:resource="urn:swrl#m"/>
                </swrl:ClassAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#Targets"/>
                      <swrl:argument1 rdf:resource="urn:swrl#m"/>
                      <swrl:argument2 rdf:resource="urn:swrl#v"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#Targets"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
          <swrl:argument2 rdf:resource="urn:swrl#v"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#ThreatActor"/>
    <rdf:Description rdf:about="#Malware"/>
    <rdf:Description rdf:about="#Vulnerability"/>
    <rdf:Description rdf:about="#Indicator"/>
    <rdf:Description rdf:about="#Campaign"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
